# Plantilla. Copia a keystore.properties y rellena con tus credenciales.
# Genera el keystore con:
#   keytool -genkeypair -v -storetype PKCS12 -keystore android/app/release.keystore \
#     -alias calendarmemory -keyalg RSA -keysize 2048 -validity 10950
storeFile=release.keystore
storePassword=
keyAlias=calendarmemory
keyPassword=
