# Plantilla. Copia a keystore.properties y rellena con tus credenciales.
# Genera el keystore con (PowerShell, desde la raiz del repo):
#   & "$env:JAVA_HOME\bin\keytool.exe" -genkeypair -v -storetype PKCS12 -keystore android\app\release.keystore -alias calendarmemory -keyalg RSA -keysize 2048 -validity 10950
storeFile=release.keystore
storePassword=
keyAlias=calendarmemory
keyPassword=
